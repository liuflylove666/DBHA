[Unit]
Description=DBHA research etcd container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/dbha/etcd

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm dbha-etcd
ExecStart=/usr/bin/docker run --rm --name dbha-etcd --network host --env-file /etc/dbha/etcd.env -v /srv/dbha/etcd:/etcd-data gcr.io/etcd-development/etcd:v3.6.0 /usr/local/bin/etcd
ExecStop=/usr/bin/docker stop --time 30 dbha-etcd
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

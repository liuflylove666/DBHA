[Unit]
Description=DBHA v2 standalone metadata API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=dbha
Group=dbha
WorkingDirectory=/opt/dbha
RuntimeDirectory=standalone-metadata
RuntimeDirectoryMode=0750
LogsDirectory=dbha
LogsDirectoryMode=0750
UMask=0077
EnvironmentFile=/etc/dbha/metadata.env
ExecStartPre=/usr/bin/test -x /opt/dbha/bin/standalone-metadata
ExecStart=/opt/dbha/bin/standalone-metadata
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

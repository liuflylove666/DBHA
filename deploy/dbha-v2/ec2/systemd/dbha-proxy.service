[Unit]
Description=BlueKing Proxy for DBHA research (vendor release in local image)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm dbha-proxy
ExecStart=/usr/bin/docker run --rm --name dbha-proxy --network host --env-file /etc/dbha/proxy.env -v /var/log/mysql-proxy:/var/log/mysql-proxy dbha-ec2-proxy:local
ExecStop=/usr/bin/docker stop --time 30 dbha-proxy
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
